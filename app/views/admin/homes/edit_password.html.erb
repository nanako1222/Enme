<%# ─── 管理者帯 ──────────────────────── %>
<div class="admin-notice-band">
  <div class="container">
    <p><i class="fas fa-shield-alt me-1"></i>管理者ページ｜パスワード変更</p>
  </div>
</div>

<%# ─── ページヘッダー ─────────────────── %>
<div class="menu-list-header">
  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      <h1 class="menu-list-header__title">
        <i class="fas fa-key me-2"></i>パスワード変更
      </h1>
      <%= link_to admin_path, class: "btn menu-back-btn" do %>
        <i class="fas fa-arrow-left me-1"></i>飲食店一覧に戻る
      <% end %>
    </div>
  </div>
</div>

<div class="container py-5">
  <div class="mypage-card" style="max-width: 520px;">

    <%= form_with model: current_admin, url: admin_update_password_path, method: :patch, local: true do |f| %>
      <%= render "admin/shared/error_messages", resource: current_admin %>

      <div class="mb-4">
        <%= f.label :current_password, "現在のパスワード", class: "auth-form__label" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
            class: "form-control auth-form__input" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "新しいパスワード", class: "auth-form__label" %>
        <p class="text-muted small mb-1">半角英大文字・小文字・数字・記号を含む8文字以上</p>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "form-control auth-form__input" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "auth-form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "form-control auth-form__input" %>
      </div>

      <div class="d-grid mt-2">
        <%= f.submit "パスワードを変更する", class: "btn admin-auth-submit-btn" %>
      </div>
    <% end %>

  </div>
</div>
